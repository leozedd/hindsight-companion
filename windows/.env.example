# Template only. Edit locally; never commit the resulting .env.
HINDSIGHT_API_HOST=127.0.0.1
HINDSIGHT_API_PORT=8888
HINDSIGHT_API_DATABASE_URL=pg0://hindsight
HINDSIGHT_API_TENANT_EXTENSION=hindsight_api.extensions.builtin.tenant:ApiKeyTenantExtension
HINDSIGHT_API_TENANT_API_KEY=
HINDSIGHT_API_TENANT_MCP_AUTH_DISABLED=false
HINDSIGHT_API_LLM_PROVIDER=openai-responses
HINDSIGHT_API_LLM_BASE_URL=https://api.openai.com/v1
HINDSIGHT_API_LLM_MODEL=YOUR_MODEL_ID
HINDSIGHT_API_LLM_API_KEY=
HINDSIGHT_API_DECISION_MODEL_PROVIDER=none
HINDSIGHT_API_EMBEDDINGS_PROVIDER=local
HINDSIGHT_API_EMBEDDINGS_LOCAL_MODEL=REPLACE_WITH_LOCAL_EMBEDDING_MODEL_PATH
HINDSIGHT_API_EMBEDDINGS_LOCAL_FORCE_CPU=false
HINDSIGHT_API_EMBEDDINGS_LOCAL_TRUST_REMOTE_CODE=false
HINDSIGHT_API_EMBEDDINGS_LOCAL_MAX_CONCURRENT=1
HINDSIGHT_API_RERANKER_PROVIDER=local
HINDSIGHT_API_RERANKER_LOCAL_MODEL=REPLACE_WITH_LOCAL_RERANKER_MODEL_PATH
HINDSIGHT_API_RERANKER_LOCAL_FORCE_CPU=false
HINDSIGHT_API_RERANKER_LOCAL_TRUST_REMOTE_CODE=false
HINDSIGHT_API_RERANKER_LOCAL_FP16=true
HINDSIGHT_API_RERANKER_LOCAL_BATCH_SIZE=8
HINDSIGHT_API_RERANKER_LOCAL_MAX_CONCURRENT=1
HF_HUB_OFFLINE=1
TRANSFORMERS_OFFLINE=1
# Optional: test recall against an existing bank after a backend upgrade.
# HINDSIGHT_COMPANION_VERIFY_BANK=my-bank
